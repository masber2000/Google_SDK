# Copy this file to weather_agent/.env and fill in your key. Never commit .env.
# Get a Gemini API key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# --- OR, on Google Cloud (Gemini Enterprise Agent Platform / Vertex AI) ---
# Comment out GOOGLE_API_KEY above and use these instead:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: override the model (default: gemini-2.5-flash). The GUI also has a picker.
# WEATHER_AGENT_MODEL=gemini-2.5-flash

# --- Claude (optional) ---
# Set WEATHER_AGENT_MODEL=claude-opus-5-5 (or pick it in the GUI), then EITHER:
#   * add an Anthropic API key (https://console.anthropic.com) -> calls the Anthropic API:
# ANTHROPIC_API_KEY=sk-ant-...
#   * or leave it unset -> calls Claude in Agent Platform with the GOOGLE_CLOUD_* settings
#     above (Claude must be enabled in Model Garden; GOOGLE_CLOUD_LOCATION=global recommended).
# WEATHER_AGENT_CLAUDE_EFFORT=low     # low | medium | high | xhigh | max

# Set to 0 to skip the GUI's start-up warm-up (one tiny model call per model).
# WEATHER_AGENT_WARMUP=1
